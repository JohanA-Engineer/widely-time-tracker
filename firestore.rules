rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD
    // =========================================================================

    // Verifica si el usuario autenticado es la Administradora Maestra (Lina)
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == "linadelae@gmail.com" ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin")
      );
    }

    // Verifica si la solicitud proviene de cualquier usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtiene el trabajadorId asignado al usuario autenticado desde /usuarios/{uid}
    function getUserWorkerId() {
      return (request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))) ?
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.trabajadorId : null;
    }

    // =========================================================================
    // REGLAS POR COLECCIÓN
    // =========================================================================

    // 1. Colección de Usuarios (/usuarios/{userId})
    match /usuarios/{userId} {
      // Todos los usuarios autenticados pueden consultar perfiles
      allow read: if isAuthenticated();
      
      // Un usuario solo puede crear su propio perfil inicial
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Un usuario puede actualizar sus datos personales (nombre, foto),
      // pero NUNCA puede auto-asignarse el rol 'admin' (solo Lina puede cambiar roles)
      allow update: if isAuthenticated() && (
        isMasterAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol'])))
      );
      
      // Solo Lina puede eliminar cuentas de usuario
      allow delete: if isMasterAdmin();
    }

    // 2. Colección de Trabajadores (/trabajadores/{workerId})
    match /trabajadores/{workerId} {
      // Todos los colaboradores autenticados pueden ver la lista y sus tarifas asignadas
      allow read: if isAuthenticated();
      
      // Solo Lina puede crear trabajadores con tarifa definida;
      // si un nuevo usuario se autoregistra, su tarifa inicial debe ser 0 obligatoriamente
      allow create: if isMasterAdmin() || (
        isAuthenticated() && request.resource.data.tarifaHora == 0
      );
      
      // ÚNICAMENTE Lina puede modificar tarifas por hora o datos de los trabajadores
      allow update: if isMasterAdmin();
      
      // ÚNICAMENTE Lina puede eliminar trabajadores
      allow delete: if isMasterAdmin();
    }

    // 3. Colección de Tareas Registradas (/tareas/{taskId})
    match /tareas/{taskId} {
      // Privacidad Estricta: Lina consulta todas las tareas del equipo;
      // un colaborador SOLO puede consultar sus propias tareas registradas
      allow read: if isMasterAdmin() || (
        isAuthenticated() && (
          (getUserWorkerId() != null && resource.data.trabajadorId == getUserWorkerId()) ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid)
        )
      );
      
      // Autoría Estricta: Un colaborador solo puede registrar tareas a su propio nombre y trabajadorId
      allow create: if isAuthenticated() && (
        isMasterAdmin() || (
          request.resource.data.horas > 0 &&
          request.resource.data.descripcion is string &&
          (
            (getUserWorkerId() != null && request.resource.data.trabajadorId == getUserWorkerId()) ||
            (request.resource.data.userId == request.auth.uid)
          )
        )
      );
      
      // Solo Lina puede modificar o eliminar tareas ya registradas (auditoría financiera)
      allow update, delete: if isMasterAdmin();
    }

    // 4. Colección de Pagos y Desembolsos (/pagos/{paymentId})
    match /pagos/{paymentId} {
      // Privacidad Estricta: Lina consulta todos los pagos;
      // un colaborador SOLO puede consultar sus propios recibos y desembolsos
      allow read: if isMasterAdmin() || (
        isAuthenticated() && (
          getUserWorkerId() != null && resource.data.trabajadorId == getUserWorkerId()
        )
      );
      
      // ÚNICAMENTE la Administradora Maestra (Lina) puede registrar, editar o anular pagos
      // Ningún colaborador puede crear o alterar comprobantes de pago bajo ninguna circunstancia
      allow create, update, delete: if isMasterAdmin();
    }
  }
}
