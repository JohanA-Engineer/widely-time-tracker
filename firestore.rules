rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD
    // =========================================================================

    // El correo del token solo cuenta si Firebase confirmó que pertenece al usuario
    // (Google lo verifica siempre; con correo y contraseña requiere el enlace de verificación)
    function hasVerifiedEmail() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // Verifica si el usuario autenticado es la Administradora Maestra (Lina),
    // un administrador promovido (rol "admin" asignado por un admin) o un correo
    // autorizado en /configuracion/admins (solo editable por administradores)
    function isMasterAdmin() {
      return request.auth != null && (
        (hasVerifiedEmail() && request.auth.token.email.lower() == "linadelae@gmail.com") ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin") ||
        (hasVerifiedEmail() &&
         exists(/databases/$(database)/documents/configuracion/admins) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/configuracion/admins).data.get('emails', []))
      );
    }

    // Verifica si la solicitud proviene de cualquier usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtiene el trabajadorId asignado al usuario autenticado desde /usuarios/{uid}
    function getUserWorkerId() {
      return (request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))) ?
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('trabajadorId', null) : null;
    }

    // Un usuario solo puede vincularse a una ficha de trabajador creada por él mismo (ownerUid).
    // Las fichas creadas por la administradora solo las vincula la administradora.
    function ownsWorkerOrNone(workerId) {
      return workerId == null || (
        exists(/databases/$(database)/documents/trabajadores/$(workerId)) &&
        get(/databases/$(database)/documents/trabajadores/$(workerId)).data.get('ownerUid', null) == request.auth.uid
      );
    }

    // El campo email del perfil solo puede ser el correo real de la cuenta (o no cambiar)
    function keepsOwnEmail() {
      return !('email' in request.resource.data) ||
        (resource != null && request.resource.data.email == resource.data.get('email', null)) ||
        request.resource.data.email.lower() == request.auth.token.get('email', '').lower();
    }

    // Colaborador aprobado: su ficha la creó la administradora, o la administradora ya le asignó
    // una tarifa (las fichas autocreadas al registrarse nacen sin dueño aprobado y con tarifas en 0)
    function isApprovedWorker() {
      let workerId = getUserWorkerId();
      let worker = get(/databases/$(database)/documents/trabajadores/$(workerId)).data;
      return workerId != null && (
        worker.get('ownerUid', null) == null ||
        worker.get('tarifaHora', 0) > 0 ||
        worker.get('tarifaArte', 0) > 0
      );
    }

    // IDs generados por la app (addDoc): solo letras, números, guion y guion bajo.
    // Evita que un ID elegido a mano lleve comillas o código a la interfaz de la administradora.
    function isSafeId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // Tarea registrada por un colaborador aprobado: siempre a su nombre, siempre pendiente de aprobación,
    // con campos de tamaño acotado y un costo que no supera su tarifa real guardada en /trabajadores
    function isValidWorkerTask() {
      let data = request.resource.data;
      let workerId = getUserWorkerId();
      let worker = get(/databases/$(database)/documents/trabajadores/$(workerId)).data;
      return workerId != null &&
        isApprovedWorker() &&
        data.descripcion.size() <= 1000 &&
        data.get('cliente', '') is string && data.get('cliente', '').size() <= 120 &&
        data.get('categoria', 'general') is string && data.get('categoria', 'general').size() <= 30 &&
        data.get('segundos', 0) is number && data.get('segundos', 0) >= 0 &&
        data.trabajadorId == workerId &&
        data.userId == request.auth.uid &&
        data.estado == "pendiente" &&
        data.get('trabajadorNombre', '') == worker.get('nombre', '') &&
        data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.costoTotal is number && data.costoTotal >= 0 &&
        data.tarifaHora == worker.get('tarifaHora', 0) &&
        (
          (data.get('cantidadArtes', 0) == 0 &&
           data.costoTotal <= data.horas * data.tarifaHora * 1.01 + 0.01) ||
          (data.cantidadArtes is int && data.cantidadArtes > 0 &&
           data.tarifaArte == worker.get('tarifaArte', 0) &&
           data.costoTotal <= data.cantidadArtes * data.tarifaArte + 0.01)
        );
    }

    // =========================================================================
    // REGLAS POR COLECCIÓN
    // =========================================================================

    // 1. Colección de Usuarios (/usuarios/{userId})
    match /usuarios/{userId} {
      // Cada usuario consulta solo su propio perfil; los administradores consultan todos
      allow read: if isAuthenticated() && (request.auth.uid == userId || isMasterAdmin());

      // Un usuario solo puede crear su propio perfil inicial, siempre como colaborador
      // y vinculado únicamente a una ficha de trabajador propia
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isMasterAdmin() || (
          request.resource.data.get('rol', 'worker') == "worker" &&
          keepsOwnEmail() &&
          ownsWorkerOrNone(request.resource.data.get('trabajadorId', null))
        )
      );

      // Un usuario puede actualizar sus datos personales (nombre, foto, banco),
      // pero NUNCA puede auto-asignarse el rol 'admin' ni vincularse a la ficha de otro trabajador
      allow update: if isAuthenticated() && (
        isMasterAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']) &&
         keepsOwnEmail() &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['trabajadorId']) ||
          ownsWorkerOrNone(request.resource.data.get('trabajadorId', null))))
      );

      // Solo Lina puede eliminar cuentas de usuario
      allow delete: if isMasterAdmin();
    }

    // 2. Colección de Trabajadores (/trabajadores/{workerId})
    match /trabajadores/{workerId} {
      // Administradores ven todos; cada colaborador solo su propia ficha (datos bancarios y tarifas)
      allow read: if isAuthenticated() && (
        isMasterAdmin() ||
        getUserWorkerId() == workerId ||
        resource.data.get('ownerUid', null) == request.auth.uid
      );

      // Administradores pueden crear colaboradores (incluyendo perfiles de solo datos con tarifa definida);
      // si un nuevo usuario se autoregistra, su ficha queda a su nombre (ownerUid) y sus tarifas en 0
      allow create: if isMasterAdmin() || (
        isAuthenticated() &&
        isSafeId(workerId) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.get('tarifaHora', 0) == 0 &&
        request.resource.data.get('tarifaArte', 0) == 0
      );

      // Administradores pueden modificar cualquier dato;
      // Colaboradores vinculados pueden actualizar sus datos bancarios y personales (sin alterar tarifas ni dueño)
      allow update: if isMasterAdmin() || (
        isAuthenticated() && getUserWorkerId() == workerId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tarifaHora', 'tarifaArte', 'ownerUid']))
      );

      // ÚNICAMENTE Administradores pueden eliminar trabajadores
      allow delete: if isMasterAdmin();
    }

    // 3. Colección de Tareas Registradas (/tareas/{taskId})
    match /tareas/{taskId} {
      // Administradores consultan todas; cada colaborador solo las de su propia ficha
      allow read: if isAuthenticated() && (
        isMasterAdmin() || (getUserWorkerId() != null && resource.data.trabajadorId == getUserWorkerId())
      );

      // Registro de tareas (por horas o por piezas de diseño de artes).
      // Los colaboradores solo registran tareas propias, pendientes y con su tarifa real.
      allow create: if isAuthenticated() && (
        (request.resource.data.horas > 0 || (request.resource.data.cantidadArtes is number && request.resource.data.cantidadArtes > 0)) &&
        request.resource.data.descripcion is string
      ) && (isMasterAdmin() || (isSafeId(taskId) && isValidWorkerTask()));

      // Solo Lina puede modificar o eliminar tareas ya registradas (auditoría financiera)
      allow update, delete: if isMasterAdmin();
    }

    // 4. Colección de Pagos y Desembolsos (/pagos/{paymentId})
    match /pagos/{paymentId} {
      // Administradores consultan todos; cada colaborador solo los pagos que recibió
      allow read: if isAuthenticated() && (
        isMasterAdmin() || (getUserWorkerId() != null && resource.data.trabajadorId == getUserWorkerId())
      );

      // ÚNICAMENTE la Administradora Maestra (Lina) puede registrar, editar o anular pagos
      // Ningún colaborador puede crear o alterar comprobantes de pago bajo ninguna circunstancia
      allow create, update, delete: if isMasterAdmin();
    }

    // 5. Colección de Configuración Administrativa (/configuracion/{docId})
    match /configuracion/{docId} {
      // La lista de administradores es legible por colaboradores aprobados (la app la usa para mostrar roles);
      // el resto de configuraciones (presupuesto Upwork) es solo para administradores
      allow read: if isAuthenticated() && (isMasterAdmin() || (docId == "admins" && isApprovedWorker()));

      // ÚNICAMENTE la Administradora Maestra (Lina) puede modificar configuraciones como el presupuesto Upwork
      allow write: if isMasterAdmin();
    }

    // 6. Colección de Clientes y Presupuestos (/clientes/{clientId})
    match /clientes/{clientId} {
      // Los colaboradores aprobados la usan para autocompletar el cliente de sus tareas;
      // una cuenta recién registrada no la ve hasta que la administradora le asigne tarifa
      allow read: if isAuthenticated() && (isMasterAdmin() || isApprovedWorker());
      allow write: if isMasterAdmin();
    }
  }
}
